{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build:wasm": {
      "outputs": ["wasm/**"]
    },
    "build": {
      "dependsOn": ["^build", "build:wasm"],
      "outputs": ["dist/**", "build/**"]
    },
    "dev": {
      "dependsOn": ["build:wasm"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build", "build:wasm"]
    },
    "typecheck": {
      "dependsOn": ["^build", "build:wasm"]
    }
  }
}
