{
	"name": "@clingo-design/app",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
		"test": "node --test \"src/**/*.test.ts\"",
		"test:e2e": "playwright test",
		"test:e2e:install": "playwright install chromium"
	},
	"dependencies": {
		"@chenglou/pretext": "^0.0.8",
		"@clingo-design/canvas": "workspace:*",
		"@clingo-design/canvas-3d": "workspace:*",
		"@clingo-design/clingo-wasm": "workspace:*",
		"@clingo-design/design-core": "workspace:*",
		"@clingo-design/export-core": "workspace:*",
		"@clingo-design/export-gltf": "workspace:*",
		"@clingo-design/export-html": "workspace:*",
		"@clingo-design/export-svg": "workspace:*",
		"@clingo-design/vfs": "workspace:*",
		"@tanstack/react-hotkeys": "0.10.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-router": "^8.3.0"
	},
	"devDependencies": {
		"@automerge/automerge": "3.3.0-fragments.2",
		"@playwright/test": "^1.62.1",
		"@types/node": "^26.2.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.1.0",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vite-plugin-wasm": "^3.5.0"
	}
}
